{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "lib",
    "rootDir": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": ["lib", "node_modules"]
}
